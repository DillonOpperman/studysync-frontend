# StudySync frontend — example only. This file is documentation.
# Runtime URL overrides live in src/config/local.ts (copy from local.ts.example).
#
# Rust backend listens on 0.0.0.0:8080 by default (SERVER_PORT).
# API prefix: /api/v1
#
# Android emulator → http://10.0.2.2:8080
# iOS simulator    → http://127.0.0.1:8080
# Physical device  → http://<your-lan-ip>:8080
#
# Never put production secrets, JWT keys, or refresh tokens here.
